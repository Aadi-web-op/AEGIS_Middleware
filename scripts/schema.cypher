// ==============================================================================
// AEGIS Decision Graph - Neo4j Constraints and Indexes Schema
// Per "Aegis Decision Graph (Neo4j Add-on): Team Brief" (Oct 22, 2026)
// ==============================================================================

// --- Uniqueness Constraints (Rule 3 & Node Identities) -----------------------

// A Decision is identified by request_id alone
CREATE CONSTRAINT decision_request_id IF NOT EXISTS
FOR (d:Decision) REQUIRE d.request_id IS UNIQUE;

// Other nodes carry their own unique IDs generated by the trace builder
CREATE CONSTRAINT claim_id IF NOT EXISTS
FOR (c:Claim) REQUIRE c.id IS UNIQUE;

CREATE CONSTRAINT evidence_id IF NOT EXISTS
FOR (e:Evidence) REQUIRE e.id IS UNIQUE;

// Document IDs are global: doc:<source>@<version> (enables cross-decision analysis)
CREATE CONSTRAINT document_id IF NOT EXISTS
FOR (d:Document) REQUIRE d.id IS UNIQUE;

CREATE CONSTRAINT reason_id IF NOT EXISTS
FOR (r:Reason) REQUIRE r.id IS UNIQUE;


// --- Indexes for Fast Query Performance & Insights ----------------------------

// Fast lookup of Decision by id (for matching Decision id in edges)
CREATE INDEX decision_id IF NOT EXISTS
FOR (d:Decision) ON (d.id);

// Fast filtering by decision type (ANSWER, CAVEAT, ESCALATE, ABSTAIN)
CREATE INDEX decision_decision IF NOT EXISTS
FOR (d:Decision) ON (d.decision);

// Document source and version lookup (for cross-decision impact analysis)
CREATE INDEX document_source IF NOT EXISTS
FOR (d:Document) ON (d.source);

CREATE INDEX document_version IF NOT EXISTS
FOR (d:Document) ON (d.version);

// Reason code lookup (e.g., CONTRADICTION, UNSUPPORTED_CLAIM, AMBIGUOUS_QUERY)
CREATE INDEX reason_code IF NOT EXISTS
FOR (r:Reason) ON (r.code);

// Conflict kind lookup on CONFLICTS_WITH edges (numeric, date, statement, version)
CREATE INDEX conflicts_with_kind IF NOT EXISTS
FOR ()-[r:CONFLICTS_WITH]-() ON (r.kind);
