# Aegis configuration. Copy to .env and edit as needed.
# .env is gitignored; this file is the committed template.
#
# Every variable below is OPTIONAL. With none of them set, Aegis runs with
# working defaults and the full test suite passes.

# --- Neo4j: the Decision Graph add-on --------------------------------------
# Left unset on purpose. The driver is only created when NEO4J_URI is set,
# so the default configuration runs with the graph switched off: decisions,
# responses and the trace JSON in /v1/evaluate are all unaffected, and the
# frontend still draws the graph from that trace. Uncomment to persist
# traces to Neo4j (start one with: docker compose up -d neo4j).
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# Default is "password", which matches docker-compose.yml. Change it for
# anything that is not a local throwaway container.
# NEO4J_PASSWORD=password

# --- API ---------------------------------------------------------------------
# Comma-separated CORS origins for the React frontend.
# Default: http://localhost:5173,http://127.0.0.1:5173
# AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Audit storage: SQLite is the system of record ---------------------------
# The graph is a derived projection and is rebuildable from these.
# Both default to the repository root and are gitignored.
# AEGIS_AUDIT_DB_PATH=audit.db
# AEGIS_ESCALATIONS_DB_PATH=escalations.db

# --- Config file overrides ---------------------------------------------------
# AEGIS_POLICY_PATH=config/policy.yaml
# AEGIS_PROVIDERS_PATH=config/providers.yaml

# --- PDF ingestion (optional, only for scanned PDFs needing OCR) -------------
# Absolute paths to the Tesseract binary and Poppler's bin directory.
# TESSERACT_CMD=
# POPPLER_PATH=
